# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role (Server-Side Only - Never expose to client!)
# Used by Edge Functions for admin operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Webhook & Revalidation Secrets
# Generate strong random secrets (e.g., openssl rand -hex 32)
WEBHOOK_SECRET=your_webhook_secret_here
NEXT_REVALIDATE_SECRET=your_revalidate_secret_here

# Supabase Storage Configuration
STORAGE_BUCKET=portfolio-json

# Next.js Revalidation URL (Optional - for triggering ISR)
# Update this with your deployed Next.js app URL
NEXT_REVALIDATE_URL=https://your-nextjs-app.vercel.app/api/revalidate

# Local JSON Update URL (For Development - updates local public/data/ files)
# Use localhost for development, your deployed URL for production
LOCAL_JSON_UPDATE_URL=http://localhost:3000/api/update-local-json

# CDN JSON URLs (Supabase Storage Public URLs)
# Replace [project-ref] with your actual Supabase project reference
# Example: https://abcdefgh.supabase.co/storage/v1/object/public/portfolio-json/profile.json
NEXT_PUBLIC_PROFILE_JSON_URL=https://[project-ref].supabase.co/storage/v1/object/public/portfolio-json/profile.json
NEXT_PUBLIC_PROJECTS_JSON_URL=https://[project-ref].supabase.co/storage/v1/object/public/portfolio-json/projects.json
NEXT_PUBLIC_SKILLS_JSON_URL=https://[project-ref].supabase.co/storage/v1/object/public/portfolio-json/skills.json
NEXT_PUBLIC_EXPERIENCE_JSON_URL=https://[project-ref].supabase.co/storage/v1/object/public/portfolio-json/experience.json
NEXT_PUBLIC_EDUCATION_JSON_URL=https://[project-ref].supabase.co/storage/v1/object/public/portfolio-json/education.json
NEXT_PUBLIC_BLOGS_JSON_URL=https://[project-ref].supabase.co/storage/v1/object/public/portfolio-json/blogs.json
NEXT_PUBLIC_PROJECT_EXPLANATIONS_JSON_URL=https://[project-ref].supabase.co/storage/v1/object/public/portfolio-json/project-explanations.json

# EmailJS Configuration
# Get these from https://dashboard.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Instructions:
# 1. Copy this file to .env.local for local development
# 2. Copy this file to .env.production for production builds
# 3. Replace all placeholder values with your actual credentials
# 4. Never commit .env.local to Git (it's already in .gitignore)
# 5. For production, add these env vars to your hosting platform (Vercel, etc.)

Name: LOCAL_JSON_UPDATE_URL
Value: http://localhost:3000/api/update-local-json
